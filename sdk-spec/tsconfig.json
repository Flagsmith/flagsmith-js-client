{
  // Type-checks steps.mts, which runs on Node 24 against the built package in lib/flagsmith.
  // Run after `npm run bundle`: tsc -p sdk-spec
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "es2022",
    "lib": ["es2022", "dom"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "baseUrl": ".",
    "paths": {
      "@flagsmith/flagsmith/isomorphic": ["../lib/flagsmith/isomorphic.d.ts"],
      "@flagsmith/flagsmith/types": ["../lib/flagsmith/types.d.ts"]
    }
  },
  "files": ["steps.mts"]
}
